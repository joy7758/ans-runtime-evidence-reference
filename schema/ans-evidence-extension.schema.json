{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ans-runtime-evidence-reference:schema:0.1.0",
  "title": "ANS Runtime Execution Evidence Reference",
  "description": "An independent companion profile that links current ANS identity concepts to externally stored runtime execution evidence without changing the ANS wire contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_identity_reference",
    "execution_evidence_reference",
    "evidence_object",
    "verification_result",
    "audit_pointer"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "agent_identity_reference": {
      "$ref": "#/$defs/AgentIdentityReference"
    },
    "execution_evidence_reference": {
      "$ref": "#/$defs/ExecutionEvidenceReference"
    },
    "evidence_object": {
      "$ref": "#/$defs/SyntheticExecutionEvidenceObject"
    },
    "verification_result": {
      "$ref": "#/$defs/VerificationResult"
    },
    "audit_pointer": {
      "$ref": "#/$defs/AuditPointer"
    }
  },
  "$defs": {
    "AgentIdentityReference": {
      "title": "AgentIdentityReference",
      "description": "A non-authoritative reference to ANS identity state. ansId and ansName retain the spelling used by the current ANS wire contract.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ansId",
        "ansName",
        "identity_provider",
        "eventLogId",
        "eventType",
        "event_timestamp",
        "lifecycle_status",
        "scitt_receipt_uri",
        "scitt_receipt_sha256"
      ],
      "properties": {
        "ansId": {
          "type": "string",
          "format": "uuid",
          "description": "The immutable ANS agent UUID."
        },
        "ansName": {
          "type": "string",
          "format": "uri",
          "pattern": "^ans://v[0-9]+\\.[0-9]+\\.[0-9]+\\.[^\\s]+$",
          "description": "The versioned DNS-style ANS name."
        },
        "identity_provider": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "The ANS Registration Authority or resolver used for this observation."
        },
        "eventLogId": {
          "type": "string",
          "format": "uuid",
          "description": "The transparency-log event identifier being referenced."
        },
        "eventType": {
          "enum": [
            "AGENT_REGISTERED",
            "AGENT_RENEWED",
            "AGENT_DEPRECATED",
            "AGENT_REVOKED"
          ],
          "description": "A current ANS agent transparency-log event token."
        },
        "event_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "lifecycle_status": {
          "enum": [
            "ACTIVE",
            "REVOKED",
            "DEPRECATED",
            "EXPIRED",
            "WARNING"
          ],
          "description": "The observed ANS agent badge status, not an authorization decision."
        },
        "scitt_receipt_uri": {
          "type": "string",
          "format": "uri"
        },
        "scitt_receipt_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "A transport-independent pin for the referenced SCITT COSE_Sign1 receipt bytes."
        }
      }
    },
    "ExecutionEvidenceReference": {
      "title": "ExecutionEvidenceReference",
      "description": "A content-addressed reference to evidence of one bounded operation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_evidence_id",
        "ansId",
        "evidence_object_id",
        "evidence_uri",
        "digest_algorithm",
        "canonicalization",
        "evidence_sha256",
        "availability_status",
        "generated_at"
      ],
      "properties": {
        "execution_evidence_id": {
          "type": "string",
          "format": "uri"
        },
        "ansId": {
          "type": "string",
          "format": "uuid"
        },
        "evidence_object_id": {
          "type": "string",
          "format": "uri"
        },
        "evidence_uri": {
          "type": "string",
          "format": "uri"
        },
        "digest_algorithm": {
          "const": "sha-256"
        },
        "canonicalization": {
          "const": "reference-json-v0.1",
          "description": "UTF-8 JSON with sorted keys, compact separators, no NaN, and non-ASCII characters preserved. This is not a claim of RFC 8785 conformance."
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "availability_status": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE",
            "REVOKED"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "VerificationResult": {
      "title": "VerificationResult",
      "description": "A fail-closed result for ANS reference linkage, evidence presence, and digest verification.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_result_id",
        "verifier_id",
        "timestamp",
        "verification_status",
        "checks",
        "failure_reasons"
      ],
      "properties": {
        "verification_result_id": {
          "type": "string",
          "format": "uri"
        },
        "verifier_id": {
          "type": "string",
          "format": "uri"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "verification_status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity_linkage",
            "evidence_present",
            "evidence_hash"
          ],
          "properties": {
            "identity_linkage": {
              "enum": [
                "PASS",
                "FAIL"
              ]
            },
            "evidence_present": {
              "enum": [
                "PASS",
                "FAIL"
              ]
            },
            "evidence_hash": {
              "enum": [
                "PASS",
                "FAIL"
              ]
            }
          }
        },
        "failure_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "PASS"
              }
            },
            "required": [
              "verification_status"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "properties": {
                  "identity_linkage": {
                    "const": "PASS"
                  },
                  "evidence_present": {
                    "const": "PASS"
                  },
                  "evidence_hash": {
                    "const": "PASS"
                  }
                }
              },
              "failure_reasons": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "failure_reasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "AuditPointer": {
      "title": "AuditPointer",
      "description": "A pointer to a separately governed audit bundle or log entry.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_bundle_id",
        "verification_result_id",
        "audit_uri",
        "audit_sha256",
        "recorded_at"
      ],
      "properties": {
        "audit_bundle_id": {
          "type": "string",
          "format": "uri"
        },
        "verification_result_id": {
          "type": "string",
          "format": "uri"
        },
        "audit_uri": {
          "type": "string",
          "format": "uri"
        },
        "audit_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "SyntheticExecutionEvidenceObject": {
      "title": "SyntheticExecutionEvidenceObject",
      "description": "A synthetic object used only to demonstrate reference and hash binding.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "execution_evidence_id",
        "ansId",
        "timestamp",
        "task",
        "tool_call",
        "result"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "format": "uri"
        },
        "execution_evidence_id": {
          "type": "string",
          "format": "uri"
        },
        "ansId": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_id",
            "description"
          ],
          "properties": {
            "task_id": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tool_call": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_name",
            "arguments",
            "status"
          ],
          "properties": {
            "tool_name": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "const": "COMPLETED"
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "summary",
            "artifact_refs"
          ],
          "properties": {
            "status": {
              "const": "SUCCESS"
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "artifact_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    }
  }
}
